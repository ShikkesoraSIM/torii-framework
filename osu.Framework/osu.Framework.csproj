<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Label="Project">
    <TargetFramework>net10.0</TargetFramework>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyTitle>Torii Framework</AssemblyTitle>
    <AssemblyName>osu.Framework</AssemblyName>
    <Description>A 2D application/game framework written with rhythm games in mind.</Description>
    <!-- Enabling this breaks iOS projects from building due to silly naming conflicts (https://github.com/dotnet/runtime/issues/79500#issuecomment-1345624309).
         It's still enabled externally on packaging scripts so should be fine to disable in project. -->
    <!--<GenerateDocumentationFile>true</GenerateDocumentationFile>-->
    <NoWarn>$(NoWarn);CS1591;NU5104</NoWarn>
    <DefineConstants>$(DefineConstants);JETBRAINS_ANNOTATIONS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Label="Nuget">
    <Title>osu!framework</Title>
    <PackageId>ppy.osu.Framework</PackageId>
    <PackageReleaseNotes>Automated release.</PackageReleaseNotes>
    <PackageTags>osu game framework</PackageTags>
  </PropertyGroup>
  <ItemGroup Label="Package References">
    <PackageReference Include="FFmpeg.AutoGen" Version="4.3.0.1" />
    <PackageReference Include="Microsoft.Extensions.ObjectPool" Version="10.0.11" />
    <PackageReference Include="ppy.managed-midi" Version="1.10.2" />
    <PackageReference Include="ppy.Veldrid" Version="4.9.69-ga405fe8484" />
    <PackageReference Include="ppy.Veldrid.SPIRV" Version="1.0.15-g5911265ec3" />
    <PackageReference Include="SharpFNT" Version="2.0.0" />
    <!-- Held back due to licencing concerns. Silenced vulnerabilities have been mitigated. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11">
      <NoWarn>NU1902,NU1903</NoWarn>
    </PackageReference>
    <PackageReference Include="NUnit" Version="4.5.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="OpenTabletDriver" Version="0.6.7" />
    <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
    <PackageReference Include="ppy.osuTK.NS20" Version="1.0.211" />
    <PackageReference Include="StbiSharp" Version="1.2.3" />
    <PackageReference Include="ppy.SDL2-CS" Version="1.0.741-alpha" />
    <PackageReference Include="ppy.SDL3-CS" Version="2026.1002.1" />
    <PackageReference Include="ppy.osu.Framework.SourceGeneration" Version="2025.1121.1" />

    <!-- Kept ONLY for FFmpeg video decoding; proprietary BASS binaries are stripped below. -->
    <PackageReference Include="ppy.osu.Framework.NativeLibs" Version="2025.806.0-nativelibs" />

    <!-- Any version ahead of this will cause AOT issues with iOS
         See https://github.com/mono/mono/issues/21188 -->
    <PackageReference Include="Microsoft.Diagnostics.Runtime" Version="2.0.161401" />

    <!-- Any version ahead of this will cause runtime issues on iOS
         See https://github.com/xoofx/markdig/issues/564 -->
    <PackageReference Include="Markdig" Version="0.23.0" />
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.11" />
  </ItemGroup>

  <!-- Bundle MIT/Public-Domain torii_audio native libraries (miniaudio + Signalsmith Stretch + stb_vorbis). -->
  <ItemGroup Label="ToriiAudioNativeLibs">
    <Content Include="runtimes\**\native\torii_audio.dll" Condition="Exists('runtimes\win-x64\native\torii_audio.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>runtimes\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="runtimes\win-x64\native\torii_audio.dll" Condition="Exists('runtimes\win-x64\native\torii_audio.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>torii_audio.dll</Link>
    </Content>
    <Content Include="runtimes\**\native\libtorii_audio.so">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="runtimes\**\native\libtorii_audio.dylib">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- Strip all proprietary BASS native binaries from ppy.osu.Framework.NativeLibs (FFmpeg stays intact). -->
  <Target Name="StripProprietaryBassNativeLibs" AfterTargets="ResolvePackageAssets;ResolveLockFileCopyLocalFiles;ComputeFilesToPublish">
    <ItemGroup>
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="$([System.String]::Copy('%(Filename)').ToLowerInvariant().Contains('bass'))" />
      <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)" Condition="$([System.String]::Copy('%(Filename)').ToLowerInvariant().Contains('bass'))" />
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="$([System.String]::Copy('%(Filename)').ToLowerInvariant().Contains('bass'))" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="$([System.String]::Copy('%(Filename)').ToLowerInvariant().Contains('bass'))" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(Filename)').ToLowerInvariant().Contains('bass'))" />
    </ItemGroup>
  </Target>
</Project>
