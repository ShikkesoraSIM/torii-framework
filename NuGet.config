<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <add key="http.timeout" value="900000" />
    <add key="packageRestore" value="true" />
    <add key="retrycount" value="5" />
    <add key="maxHttpRequestsPerSource" value="8" />
    <add key="retryDelayInMilliseconds" value="2000" />
  </config>

  <packageSources>
    <clear />
    <!--
      Local Torii.Veldrid feed for the feat/d3d12 wire-up. Produced by
      `dotnet pack -c Release` inside ../torii-veldrid. Listed FIRST so the
      pre-release Torii.Veldrid (4.9.85-g498e8f8003) is preferred over
      anything cached from nuget.org. Once Torii.Veldrid is published to
      nuget.org this entry can be deleted with no other change required.
    -->
    <add key="torii-veldrid-local" value="..\torii-veldrid\bin\Packages\Release" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <bindingRedirects>
    <add key="skip" value="False" />
  </bindingRedirects>
</configuration>
